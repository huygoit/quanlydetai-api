TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

# OpenAlex
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=

# Uploads (đính kèm hồ sơ)
# - UPLOAD_STORAGE_ROOT: đường dẫn tuyệt đối hoặc tương đối theo appRoot
# - UPLOAD_PROFILE_ATTACHMENTS_DIR: thư mục con
# - UPLOAD_PUBLIC_BASE_PATH: prefix public để FE truy cập
UPLOAD_STORAGE_ROOT=storage
UPLOAD_PROFILE_ATTACHMENTS_DIR=profile-attachments
UPLOAD_PUBLIC_BASE_PATH=/storage

# --- SMTP Office 365 ---
# Server: smtp.office365.com | Port: 587 | STARTTLS | Auth bằng tài khoản M365
SMTP_ENABLED=true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@domain.com
SMTP_PASSWORD=
SMTP_FROM=user@domain.com
