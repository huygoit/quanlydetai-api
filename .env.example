TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

# OpenAlex
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=

# Uploads (đính kèm hồ sơ)
# - UPLOAD_STORAGE_ROOT: đường dẫn tuyệt đối hoặc tương đối theo appRoot
# - UPLOAD_PROFILE_ATTACHMENTS_DIR: thư mục con
# - UPLOAD_PUBLIC_BASE_PATH: prefix public để FE truy cập
UPLOAD_STORAGE_ROOT=storage
UPLOAD_PROFILE_ATTACHMENTS_DIR=profile-attachments
UPLOAD_PUBLIC_BASE_PATH=/storage

# --- SMTP Office 365 ---
# Server: smtp.office365.com | Port: 587 | STARTTLS | Auth bằng tài khoản M365
# Chỉ gửi mail thật khi =true. false = mọi mail ghi STUB
SMTP_ENABLED=false
# Test: chỉ gửi SMTP tới các email này (phẩy/chấm phẩy). Trống = gửi tất cả (prod)
SMTP_ALLOWLIST=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@domain.com
SMTP_PASSWORD=
SMTP_FROM=user@domain.com

# --- Gửi mail broadcast CFP (2 cách, bật/tắt độc lập) ---
# QUEUE: BullMQ + Redis + `npm run worker:cfp-email`
# SYNC: gửi ngay trong process API (cách cũ, không cần Redis)
# Redis lỗi: CFP_EMAIL_QUEUE_ENABLED=false + CFP_EMAIL_SYNC_ENABLED=true
CFP_EMAIL_QUEUE_ENABLED=true
CFP_EMAIL_SYNC_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
